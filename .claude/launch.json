{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "echo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "echo-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", "-s", "dist", "-l", "5055"],
      "port": 5055
    },
    {
      "name": "portfolio",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../portfolio", "run", "dev", "--", "--port", "5180", "--strictPort"],
      "port": 5180
    }
  ]
}
